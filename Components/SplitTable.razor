<div class="card mt-6 overflow-x-auto">
    <table class="w-full text-left text-sm">
        <thead class="text-deeps-subtle text-xs uppercase tracking-wide">
            <tr>
                <th class="py-1 pr-3">Segment</th>
                <th>This run</th>
                <th>Delta</th>
                <th>@Comparison</th>
                <th>Best</th>
                <th>Avg</th>
                <th>σ</th>
                <th>Rating</th>
                <th>Time save</th>
                <th>Mistakes</th>
            </tr>
        </thead>
        <tbody class="font-mono">
            @{int rowIdx = 0;}
            @foreach (var seg in Category.Segments.OrderBy(s => s.Order))
            {
                var ri = rowIdx++;
                var thisRun = ri < Splits.Count ? Splits[ri].Duration : (TimeSpan?)null;
                var compTime = StatsService.ComparisonTime(Category, seg.Id, Comparison);
                var delta = StatsService.Delta(thisRun, compTime);
                var isActive = Running && ri == Current;
                var isGold = thisRun.HasValue && StatsService.IsGold(Category, seg.Id, thisRun.Value)
                             && Category.Runs.Any(r => r.Splits.Any(s => s.SegmentId == seg.Id));
                var rating = StatsService.ConsistencyRating(Category, seg.Id);
                var timeSave = StatsService.PossibleTimeSave(Category, seg.Id);

                <tr class="@(isActive ? "text-deeps-accent" : "") @(isGold ? "bg-deeps-warning-surface/20" : "")
                           border-t border-deeps-border">
                    <td class="py-1.5 pr-3 font-sans @(seg.ParentId.HasValue ? "pl-4 text-deeps-soft" : "")">
                        @(seg.ParentId.HasValue ? "↳ " : "")@seg.IconEmoji @seg.Name
                        @if (isGold) { <span class="ml-1 text-deeps-warning text-xs" title="Gold split!">★</span> }
                        @if (seg.GoalTime.HasValue)
                        {
                            <span class="ml-1 text-xs text-deeps-subtle">🎯@StatsService.Format(seg.GoalTime)</span>
                        }
                    </td>
                    <td>@StatsService.Format(thisRun, DecimalPlaces)</td>
                    <td class="@DeltaColor(delta)">@StatsService.FormatDelta(delta, DecimalPlaces)</td>
                    <td>@StatsService.Format(compTime)</td>
                    <td>@StatsService.Format(StatsService.BestSegment(Category, seg.Id))</td>
                    <td>@StatsService.FormatSeconds(StatsService.AverageSeconds(Category, seg.Id))</td>
                    <td>@StatsService.FormatSeconds(StatsService.Consistency(Category, seg.Id))</td>
                    <td>@(rating.HasValue ? $"{rating:F0}" : "--")</td>
                    <td>@StatsService.Format(timeSave)</td>
                    <td>@StatsService.MistakeCount(Category, seg.Id)</td>
                </tr>

                var strat = Category.Strategies.FirstOrDefault(s => s.SegmentId == seg.Id && s.IsActive);
                if (isActive && strat is not null)
                {
                    <tr class="bg-deeps-raised/60">
                        <td colspan="10" class="px-2 py-1 text-xs text-deeps-soft font-sans italic">
                            💡 <b>@strat.Title</b>: @strat.Notes
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>

    <div class="mt-3 flex flex-wrap gap-4 text-sm text-deeps-muted">
        <span>PB: <span class="font-mono text-deeps-bright">@StatsService.Format(StatsService.PersonalBest(Category)?.Total)</span></span>
        <span>Sum of best: <span class="font-mono">@StatsService.Format(StatsService.SumOfBest(Category))</span></span>
        <span>Attempts: <span class="font-mono">@Category.AttemptCount</span></span>
        @if (Category.GoalTime.HasValue)
        {
            <span>Goal: <span class="font-mono text-deeps-accent">@StatsService.Format(Category.GoalTime)</span></span>
        }
    </div>
</div>

@code {
    [Parameter] public Category Category { get; set; } = null!;
    [Parameter] public List<SplitTime> Splits { get; set; } = new();
    [Parameter] public bool Running { get; set; }
    [Parameter] public int Current { get; set; }
    [Parameter] public string Comparison { get; set; } = "PersonalBest";
    [Parameter] public int DecimalPlaces { get; set; } = 2;

    private static string DeltaColor(TimeSpan? delta) =>
        delta is null ? "" : delta.Value < TimeSpan.Zero ? "text-deeps-success" : "text-deeps-danger";
}
