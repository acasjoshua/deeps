@* Reusable card for a single strategy *@
@using Deeps.Models

<div class="rounded-lg border border-slate-700 p-3 mb-2 @(Strategy.IsActive ? "border-deeps-500 bg-deeps-900/20" : "")">
    <div class="flex items-start justify-between gap-2">
        <div class="flex-1">
            <div class="font-medium flex items-center gap-2">
                @Strategy.Title
                @if (Strategy.IsActive) { <span class="text-xs text-deeps-400 bg-deeps-900 px-1 rounded">Active</span> }
            </div>
            @if (!string.IsNullOrWhiteSpace(Strategy.Notes))
            {
                <p class="mt-1 text-sm text-slate-300 whitespace-pre-wrap">@Strategy.Notes</p>
            }
        </div>
        <div class="flex gap-1 shrink-0">
            @if (!Strategy.IsActive)
            {
                <button class="btn-ghost text-xs" @onclick="@(() => OnActivate.InvokeAsync(Strategy.Id))">Set active</button>
            }
            <button class="btn-ghost text-xs text-red-400"
                    @onclick="@(() => OnDelete.InvokeAsync(Strategy.Id))">🗑</button>
        </div>
    </div>
</div>

@code {
    [Parameter, EditorRequired] public Strategy Strategy { get; set; } = default!;
    [Parameter] public EventCallback<Guid> OnActivate { get; set; }
    [Parameter] public EventCallback<Guid> OnDelete   { get; set; }
}
