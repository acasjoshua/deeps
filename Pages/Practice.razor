@page "/practice/{CategoryId:guid}"
@inject PracticeStore    Store
@inject HotkeyService   Hotkeys
@inject IJSRuntime      JS
@implements IAsyncDisposable

@if (category is null)
{
    <p class="text-deeps-muted">Category not found.</p>
    return;
}

<PageTitle>@category.Name - DEEPS</PageTitle>

@* Keyboard listener (tab must keep focus) *@
<div tabindex="0" @ref="pageRef" class="outline-none" data-practice-hotkeys
     data-practice-space-hotkey="@(Hotkeys.IsStartOrSplit(" ") ? "true" : "false")"
     @onkeydown="OnKeyDown">

<div class="flex items-center justify-between">
    <div>
        <div class="text-xs uppercase tracking-wide text-deeps-subtle">
            @(Store.GameForCategory(CategoryId)?.Name)
        </div>
        <h1 class="text-2xl font-bold">@category.Name</h1>
    </div>
    <div class="flex gap-2 text-xs" @onkeydown:stopPropagation="true">
        <a href="history/@CategoryId" class="btn-ghost">History</a>
        <a href="strategies/@CategoryId" class="btn-ghost">Strategies</a>
        <a href="overlay/@CategoryId" class="btn-ghost" target="_blank" rel="noopener">OBS Overlay</a>
        <a href="settings" class="btn-ghost">⚙</a>
    </div>
</div>

@if (category.Segments.Count == 0)
{
    <p class="mt-4 text-deeps-muted">Add segments on the <a class="text-deeps-accent underline" href="games">Games</a> page first.</p>
    return;
}

@* ── Timer card ── *@
<div class="card mt-4">
    <TimerDisplay Elapsed="elapsed"
                  Countdown="countdown"
                  Running="running"
                  Paused="paused"
                  TimerColor="@TimerColor()"
                  CurrentSegmentName="@category.Segments.OrderBy(s => s.Order).ElementAtOrDefault(current)?.Name"
                  BestPossible="bestPossible"
                  PbTime="pbTime"
                  StartHotkey="@Hotkeys.DisplayKey(Store.Settings.HotkeyStart)"
                  DecimalPlaces="Store.Settings.TimerDecimalPlaces" />

    <ControlBar Running="running"
                Paused="paused"
                Countdown="countdown"
                CanUndo="@(splits.Count > 0)"
                SplitHotkey="@Hotkeys.DisplayKey(Store.Settings.HotkeySplit)"
                PauseHotkey="@Hotkeys.DisplayKey(Store.Settings.HotkeyPause)"
                UndoHotkey="@Hotkeys.DisplayKey(Store.Settings.HotkeyUndo)"
                SkipHotkey="@Hotkeys.DisplayKey(Store.Settings.HotkeySkip)"
                ResetHotkey="@Hotkeys.DisplayKey(Store.Settings.HotkeyReset)"
                OnStart="StartOrSplit"
                OnSplit="StartOrSplit"
                OnPause="Pause"
                OnResume="Resume"
                OnUndo="UndoSplit"
                OnSkip="SkipSplit"
                OnReset="InitiateReset" />

    @* Mistake logging *@
    @if (running || paused)
    {
        <div class="mt-4 flex flex-wrap gap-2" @onkeydown:stopPropagation="true">
            <input class="input flex-1 min-w-0" placeholder="Mistake note"
                   @bind="mistakeNote" @bind:event="oninput" />
            <select class="input w-32" @bind="mistakeCategory">
                <option value="">Category…</option>
                @foreach (var mc in mistakeCategories)
                {
                    <option value="@mc">@mc</option>
                }
            </select>
            <input class="input w-20" type="number" step="0.1" min="0" placeholder="sec lost"
                   @bind="mistakeSeconds" />
            <button class="btn-ghost" @onclick="LogMistake">Log</button>
        </div>
    }

    @* Run notes *@
    @if (running || paused)
    {
        <div class="mt-2" @onkeydown:stopPropagation="true">
            <textarea class="input w-full h-16 resize-none text-xs" placeholder="Run notes…"
                      @bind="runNotes" @bind:event="oninput"></textarea>
        </div>
    }

    @* Comparison selector *@
    <div class="mt-3 flex items-center gap-2 text-xs text-deeps-muted" @onkeydown:stopPropagation="true">
        Compare vs:
        <select class="input py-0.5 text-xs" @bind="comparison">
            <option value="PersonalBest">Personal Best</option>
            <option value="BestSegments">Best Segments</option>
            <option value="Average">Average</option>
            <option value="Median">Median</option>
            <option value="Worst">Worst</option>
        </select>
    </div>
</div>

@* Segment practice mode *@
<div class="card mt-4">
    <div class="flex items-center gap-3" @onkeydown:stopPropagation="true">
        <input type="checkbox" id="segLoop" @bind="segLoopEnabled" class="accent-deeps-500" />
        <label for="segLoop" class="text-sm font-medium">Segment loop mode</label>
        @if (segLoopEnabled)
        {
            <select class="input py-0.5 text-xs flex-1" @bind="loopSegIndex">
                @for (int i = 0; i < category.Segments.OrderBy(s=>s.Order).Count(); i++)
                {
                    var idx = i;
                    var seg = category.Segments.OrderBy(s => s.Order).ElementAt(idx);
                    <option value="@idx">@seg.Name</option>
                }
            </select>
            <span class="text-xs text-deeps-muted">Attempts: <b>@loopAttempts</b></span>
        }
    </div>
</div>

<SplitTable Category="category"
            Splits="splits"
            Running="running"
            Current="current"
            Comparison="comparison"
            DecimalPlaces="Store.Settings.TimerDecimalPlaces" />

<ConfirmDialog Visible="@showResetPrompt" OnCancel="DismissResetPrompt">
    <h3 class="font-semibold">Reset run?</h3>
    <p class="text-sm text-deeps-muted">Save this attempt to history or discard it?</p>
    <div class="flex flex-col gap-2">
        <button class="btn-primary" @onclick="ResetSave">Save run &amp; reset</button>
        <button class="btn-ghost text-deeps-danger" @onclick="ResetDiscard">Discard &amp; reset</button>
        <button class="btn-ghost" @onclick="DismissResetPrompt">Keep running</button>
    </div>
</ConfirmDialog>

</div>@* end focus wrapper *@

@code {
    [Parameter] public Guid CategoryId { get; set; }

    private Category? category;
    private bool      running;
    private bool      paused;
    private int       current;
    private TimeSpan  elapsed;
    private TimeSpan  lastSplitAt;
    private TimeSpan  pausedAt;
    private List<SplitTime> splits    = new();
    private List<Mistake>   mistakes  = new();
    private string    mistakeNote     = "";
    private string    mistakeCategory = "";
    private double    mistakeSeconds;
    private string    runNotes        = "";
    private string    comparison      = "PersonalBest";
    private TimeSpan? bestPossible;
    private TimeSpan? pbTime;
    private bool      showResetPrompt;

    // countdown
    private int       countdown;
    private Timer?    countdownTimer;

    // segment loop
    private bool      segLoopEnabled;
    private int       loopSegIndex;
    private int       loopAttempts;

    private readonly System.Diagnostics.Stopwatch sw = new();
    private Timer?    ticker;
    private Timer?    gamepadTimer;
    private Timer?    overlayTimer;
    private HashSet<int> prevGamepadButtons = new();
    private ElementReference pageRef;
    private bool overlayPublisherStarted;
    private bool disposed;

    private static readonly string[] mistakeCategories =
        { "Missed trick", "RNG", "Menu mistake", "Execution", "Knowledge", "Other" };

    protected override void OnInitialized()
    {
        gamepadTimer = new Timer(_ => InvokeAsync(CheckGamepadAsync), null, 200, 50);
    }

    protected override void OnParametersSet()
    {
        category   = Store.FindCategory(CategoryId);
        comparison = Store.Settings.Comparison;
        pbTime     = category is null ? null : StatsService.PersonalBest(category)?.Total;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && category is not null)
        {
            await pageRef.FocusAsync();
            await PublishOverlayAsync();
            overlayPublisherStarted = true;
            overlayTimer = new Timer(_ => _ = InvokeAsync(PublishOverlayAsync), null, 250, 250);
        }
    }

    // ─── Keyboard ─────────────────────────────────────────────────────────────

    private async Task OnKeyDown(KeyboardEventArgs e)
    {
        if (showResetPrompt) return;

        if (!running && !paused && Hotkeys.IsStartOrSplit(e.Key))
        {
            await InvokeAsync(StartOrSplit);
        }
        else if (running && Hotkeys.IsStartOrSplit(e.Key))
        {
            await InvokeAsync(StartOrSplit);
        }
        else if (running && Hotkeys.IsPause(e.Key))
        {
            Pause();
        }
        else if (paused && Hotkeys.IsPause(e.Key))
        {
            Resume();
        }
        else if (running && Hotkeys.IsUndo(e.Key))
        {
            UndoSplit();
        }
        else if (running && Hotkeys.IsSkip(e.Key))
        {
            SkipSplit();
        }
        else if ((running || paused) && Hotkeys.IsReset(e.Key))
        {
            InitiateReset();
        }
        StateHasChanged();
    }

    private async Task PublishOverlayAsync()
    {
        if (disposed || category is null) return;

        var state = countdown > 0 ? "Starting" : running ? "Running" : paused ? "Paused" : "Ready";
        var lastSplit = splits.LastOrDefault();
        TimeSpan? delta = null;
        if (lastSplit is not null)
        {
            var comparisonTime = StatsService.ComparisonTime(category, lastSplit.SegmentId, comparison);
            delta = StatsService.Delta(lastSplit.Duration, comparisonTime);
        }

        await JS.InvokeVoidAsync("deepsOverlayPublish", CategoryId.ToString("N"), new OverlaySnapshot
        {
            GameName = Store.GameForCategory(CategoryId)?.Name ?? "",
            CategoryName = category.Name,
            State = state,
            Elapsed = StatsService.Format(elapsed, Store.Settings.TimerDecimalPlaces),
            Countdown = countdown,
            SegmentName = running || paused
                ? category.Segments.OrderBy(s => s.Order).ElementAtOrDefault(current)?.Name
                : null,
            LastSplit = lastSplit is null
                ? null
                : StatsService.Format(lastSplit.Duration, Store.Settings.TimerDecimalPlaces),
            Delta = lastSplit is null
                ? null
                : StatsService.FormatDelta(delta, Store.Settings.TimerDecimalPlaces),
            PersonalBest = StatsService.Format(StatsService.PersonalBest(category)?.Total)
        });
    }

    // ─── Timer controls ───────────────────────────────────────────────────────

    private async Task StartOrSplit()
    {
        if (!running && !paused)
        {
            await BeginRun();
        }
        else if (running)
        {
            Split();
        }
    }

    private async Task BeginRun()
    {
        if (category is null) return;
        splits    = new();
        mistakes  = new();
        runNotes  = "";
        current   = segLoopEnabled ? loopSegIndex : 0;
        lastSplitAt = TimeSpan.Zero;
        elapsed   = TimeSpan.Zero;
        paused    = false;
        category.AttemptCount++;

        int delay = Store.Settings.StartDelay;
        if (delay > 0)
        {
            countdown = delay;
            StateHasChanged();
            countdownTimer = new Timer(_ =>
            {
                InvokeAsync(() =>
                {
                    countdown--;
                    if (countdown <= 0) { countdownTimer?.Dispose(); countdownTimer = null; ActivateTimer(); }
                    StateHasChanged();
                });
            }, null, 1000, 1000);
        }
        else
        {
            ActivateTimer();
        }
        await Store.SaveAsync(); // persist attempt count
    }

    private void ActivateTimer()
    {
        running = true;
        sw.Restart();
        ticker  = new Timer(_ => InvokeAsync(() =>
        {
            elapsed = sw.Elapsed + pausedAt;
            bestPossible = StatsService.BestPossibleTime(category!, splits, current);
            StateHasChanged();
        }), null, 0, 50);
    }

    private void Split()
    {
        if (category is null || !running) return;
        var now = sw.Elapsed + pausedAt;
        splits.Add(new SplitTime
        {
            SegmentId = category.Segments.OrderBy(s => s.Order).ElementAt(current).Id,
            Duration  = now - lastSplitAt
        });
        lastSplitAt = now;
        current++;

        if (segLoopEnabled || current >= category.Segments.Count)
        {
            if (segLoopEnabled) { loopAttempts++; lastSplitAt = now; current = loopSegIndex; }
            else Finish();
        }
    }

    private void UndoSplit()
    {
        if (splits.Count == 0) return;
        splits.RemoveAt(splits.Count - 1);
        current = Math.Max(0, current - 1);
        // Recalc lastSplitAt
        lastSplitAt = splits.Count > 0
            ? TimeSpan.FromTicks(splits.Sum(s => s.Duration.Ticks))
            : TimeSpan.Zero;
    }

    private void SkipSplit()
    {
        if (category is null || !running) return;
        var now = sw.Elapsed + pausedAt;
        // Add zero-duration split (skipped)
        splits.Add(new SplitTime
        {
            SegmentId = category.Segments.OrderBy(s => s.Order).ElementAt(current).Id,
            Duration  = TimeSpan.Zero
        });
        current++;
        if (current >= category.Segments.Count) Finish();
    }

    private void Pause()
    {
        if (!running) return;
        sw.Stop();
        ticker?.Dispose(); ticker = null;
        pausedAt = elapsed;
        running = false;
        paused  = true;
    }

    private void Resume()
    {
        if (!paused) return;
        paused = false;
        running = true;
        sw.Restart();
        ticker = new Timer(_ => InvokeAsync(() =>
        {
            elapsed = sw.Elapsed + pausedAt;
            StateHasChanged();
        }), null, 0, 50);
    }

    private void InitiateReset()
    {
        if (!running && !paused) return;
        Pause();
        showResetPrompt = true;
    }

    private async Task ResetSave()
    {
        if (category is null) return;
        showResetPrompt = false;
        StopTimer();
        var run = new Run
        {
            Completed            = false,
            ResetAtSegmentIndex  = current,
            Splits               = splits,
            Mistakes             = mistakes,
            Notes                = runNotes
        };
        await Store.SaveRunAsync(category, run);
        ResetState();
        await pageRef.FocusAsync();
    }

    private async Task ResetDiscard()
    {
        showResetPrompt = false;
        StopTimer();
        ResetState();
        await pageRef.FocusAsync();
    }

    private async Task DismissResetPrompt()
    {
        showResetPrompt = false;
        await pageRef.FocusAsync();
    }

    private void Finish()
    {
        if (category is null) return;
        StopTimer();
        var run = new Run
        {
            Completed = true,
            Splits    = splits,
            Mistakes  = mistakes,
            Notes     = runNotes
        };
        _ = Store.SaveRunAsync(category, run);
        pbTime = StatsService.PersonalBest(category)?.Total;
        ResetState();
    }

    private void StopTimer()
    {
        sw.Stop();
        ticker?.Dispose(); ticker = null;
        countdownTimer?.Dispose(); countdownTimer = null;
    }

    private void ResetState()
    {
        running = false; paused = false; current = 0;
        splits = new(); mistakes = new(); elapsed = TimeSpan.Zero;
        lastSplitAt = TimeSpan.Zero; pausedAt = TimeSpan.Zero;
        bestPossible = null; countdown = 0;
    }

    private void LogMistake()
    {
        if (category is null || string.IsNullOrWhiteSpace(mistakeNote)) return;
        int segIdx = Math.Min(current, category.Segments.Count - 1);
        mistakes.Add(new Mistake
        {
            SegmentId  = category.Segments.OrderBy(s => s.Order).ElementAt(segIdx).Id,
            Note       = mistakeNote.Trim(),
            Category   = mistakeCategory,
            SecondsLost= mistakeSeconds
        });
        mistakeNote = ""; mistakeCategory = ""; mistakeSeconds = 0;
    }

    // ─── Colour helpers ───────────────────────────────────────────────────────

    private string TimerColor()
    {
        if (!running && !paused) return "text-deeps-bright-soft";
        if (paused) return "text-deeps-muted";
        if (splits.Count == 0) return "text-deeps-bright";
        var last = splits[^1];
        var comp = StatsService.ComparisonTime(category!, last.SegmentId, comparison);
        var delta = StatsService.Delta(last.Duration, comp);
        if (delta is null) return "text-deeps-bright";
        return delta.Value < TimeSpan.Zero ? "text-deeps-success" : "text-deeps-danger";
    }

    private async Task CheckGamepadAsync()
    {
        if (showResetPrompt) return;
        if (!Store.Settings.GamepadEnabled) return;
        try
        {
            var pressedButtons = await JS.InvokeAsync<int[]>("deepsGamepadButtons", 0);
            if (pressedButtons is null) return;
            var currentSet = new HashSet<int>(pressedButtons);

            foreach (var btn in currentSet)
            {
                if (!prevGamepadButtons.Contains(btn))
                {
                    if (btn == Store.Settings.GamepadButtonStartSplit)
                    {
                        await StartOrSplit();
                    }
                    else if (btn == Store.Settings.GamepadButtonPause)
                    {
                        if (running) Pause();
                        else if (paused) Resume();
                    }
                    else if (btn == Store.Settings.GamepadButtonUndo)
                    {
                        if (running) UndoSplit();
                    }
                    else if (btn == Store.Settings.GamepadButtonSkip)
                    {
                        if (running) SkipSplit();
                    }
                    else if (btn == Store.Settings.GamepadButtonReset)
                    {
                        if (running || paused) InitiateReset();
                    }
                }
            }
            prevGamepadButtons = currentSet;
            StateHasChanged();
        }
        catch { }
    }

    public async ValueTask DisposeAsync()
    {
        disposed = true;
        ticker?.Dispose();
        countdownTimer?.Dispose();
        gamepadTimer?.Dispose();
        overlayTimer?.Dispose();
        if (overlayPublisherStarted)
            await JS.InvokeVoidAsync("deepsOverlayClosePublisher", CategoryId.ToString("N"));
    }
}
