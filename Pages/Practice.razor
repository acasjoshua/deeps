@page "/practice/{CategoryId:guid}"
@inject PracticeStore    Store
@inject HotkeyService   Hotkeys
@inject IJSRuntime      JS
@implements IDisposable

@if (category is null)
{
    <p class="text-slate-400">Category not found.</p>
    return;
}

<PageTitle>@category.Name - DEEPS</PageTitle>

@* Keyboard listener (tab must keep focus) *@
<div tabindex="0" @ref="pageRef" class="outline-none" data-practice-hotkeys
     data-practice-space-hotkey="@(Hotkeys.IsStartOrSplit(" ") ? "true" : "false")"
     @onkeydown="OnKeyDown">

<div class="flex items-center justify-between">
    <div>
        <div class="text-xs uppercase tracking-wide text-slate-500">
            @(Store.GameForCategory(CategoryId)?.Name)
        </div>
        <h1 class="text-2xl font-bold">@category.Name</h1>
    </div>
    <div class="flex gap-2 text-xs" @onkeydown:stopPropagation="true">
        <a href="history/@CategoryId" class="btn-ghost">History</a>
        <a href="strategies/@CategoryId" class="btn-ghost">Strategies</a>
        <a href="settings" class="btn-ghost">⚙</a>
    </div>
</div>

@if (category.Segments.Count == 0)
{
    <p class="mt-4 text-slate-400">Add segments on the <a class="text-deeps-400 underline" href="games">Games</a> page first.</p>
    return;
}

@* ── Timer card ── *@
<div class="card mt-4">
    @* Countdown overlay *@
    @if (countdown > 0)
    {
        <div class="mb-2 text-center text-6xl font-mono font-bold text-deeps-400">@countdown</div>
    }
    else
    {
        <div class="font-mono text-5xl @TimerColor()">
            @StatsService.Format(elapsed, Store.Settings.TimerDecimalPlaces)
        </div>
    }

    <div class="mt-1 flex gap-4 text-sm text-slate-400">
        @if (running || paused)
        {
            <span>Segment: <b class="text-white">@category.Segments.OrderBy(s=>s.Order).ElementAtOrDefault(current)?.Name</b></span>
            @if (bestPossible.HasValue)
            {
                <span>Best possible: <span class="font-mono text-deeps-300">@StatsService.Format(bestPossible)</span></span>
            }
        }
        else
        {
            <span>Ready — press <kbd class="rounded bg-slate-700 px-1">@Hotkeys.DisplayKey(Store.Settings.HotkeyStart)</kbd> to start</span>
        }
    </div>

    @* PB / Goal progress bar *@
    @if ((running || paused) && pbTime.HasValue)
    {
        var pct = Math.Clamp((int)(elapsed.TotalSeconds / pbTime.Value.TotalSeconds * 100), 0, 100);
        <div class="mt-2 h-1.5 w-full rounded bg-slate-700">
            <div class="h-full rounded bg-deeps-500 transition-all"
                 style="width:@(pct)%"></div>
        </div>
        <div class="mt-0.5 text-xs text-slate-500">PB pace: @pct%</div>
    }

    @* Control buttons *@
    <div class="mt-4 flex flex-wrap gap-2" @onkeydown:stopPropagation="true">
        @if (!running && !paused && countdown == 0)
        {
            <button class="btn-primary" @onclick="StartOrSplit">Start</button>
        }
        @if (running)
        {
            <button class="btn-primary"  @onclick="StartOrSplit">Split
                <span class="ml-1 text-xs opacity-60">[@Hotkeys.DisplayKey(Store.Settings.HotkeySplit)]</span></button>
            <button class="btn-ghost"    @onclick="Pause">Pause
                <span class="ml-1 text-xs opacity-60">[@Hotkeys.DisplayKey(Store.Settings.HotkeyPause)]</span></button>
            <button class="btn-ghost"    @onclick="UndoSplit" disabled="@(splits.Count == 0)">Undo
                <span class="ml-1 text-xs opacity-60">[@Hotkeys.DisplayKey(Store.Settings.HotkeyUndo)]</span></button>
            <button class="btn-ghost"    @onclick="SkipSplit">Skip
                <span class="ml-1 text-xs opacity-60">[@Hotkeys.DisplayKey(Store.Settings.HotkeySkip)]</span></button>
            <button class="btn-ghost text-red-400" @onclick="InitiateReset">Reset
                <span class="ml-1 text-xs opacity-60">[@Hotkeys.DisplayKey(Store.Settings.HotkeyReset)]</span></button>
        }
        @if (paused)
        {
            <button class="btn-primary"  @onclick="Resume">Resume</button>
            <button class="btn-ghost text-red-400" @onclick="InitiateReset">Reset</button>
        }
    </div>

    @* Mistake logging *@
    @if (running || paused)
    {
        <div class="mt-4 flex flex-wrap gap-2" @onkeydown:stopPropagation="true">
            <input class="input flex-1 min-w-0" placeholder="Mistake note"
                   @bind="mistakeNote" @bind:event="oninput" />
            <select class="input w-32" @bind="mistakeCategory">
                <option value="">Category…</option>
                @foreach (var mc in mistakeCategories)
                {
                    <option value="@mc">@mc</option>
                }
            </select>
            <input class="input w-20" type="number" step="0.1" min="0" placeholder="sec lost"
                   @bind="mistakeSeconds" />
            <button class="btn-ghost" @onclick="LogMistake">Log</button>
        </div>
    }

    @* Run notes *@
    @if (running || paused)
    {
        <div class="mt-2" @onkeydown:stopPropagation="true">
            <textarea class="input w-full h-16 resize-none text-xs" placeholder="Run notes…"
                      @bind="runNotes" @bind:event="oninput"></textarea>
        </div>
    }

    @* Comparison selector *@
    <div class="mt-3 flex items-center gap-2 text-xs text-slate-400" @onkeydown:stopPropagation="true">
        Compare vs:
        <select class="input py-0.5 text-xs" @bind="comparison">
            <option value="PersonalBest">Personal Best</option>
            <option value="BestSegments">Best Segments</option>
            <option value="Average">Average</option>
            <option value="Median">Median</option>
            <option value="Worst">Worst</option>
        </select>
    </div>
</div>

@* Segment practice mode *@
<div class="card mt-4">
    <div class="flex items-center gap-3" @onkeydown:stopPropagation="true">
        <input type="checkbox" id="segLoop" @bind="segLoopEnabled" class="accent-deeps-500" />
        <label for="segLoop" class="text-sm font-medium">Segment loop mode</label>
        @if (segLoopEnabled)
        {
            <select class="input py-0.5 text-xs flex-1" @bind="loopSegIndex">
                @for (int i = 0; i < category.Segments.OrderBy(s=>s.Order).Count(); i++)
                {
                    var idx = i;
                    var seg = category.Segments.OrderBy(s => s.Order).ElementAt(idx);
                    <option value="@idx">@seg.Name</option>
                }
            </select>
            <span class="text-xs text-slate-400">Attempts: <b>@loopAttempts</b></span>
        }
    </div>
</div>

@* ── Splits table ── *@
<div class="card mt-6 overflow-x-auto">
    <table class="w-full text-left text-sm">
        <thead class="text-slate-500 text-xs uppercase tracking-wide">
            <tr>
                <th class="py-1 pr-3">Segment</th>
                <th>This run</th>
                <th>Delta</th>
                <th>@comparison</th>
                <th>Best</th>
                <th>Avg</th>
                <th>σ</th>
                <th>Rating</th>
                <th>Time save</th>
                <th>Mistakes</th>
            </tr>
        </thead>
        <tbody class="font-mono">
            @{int rowIdx = 0;}
            @foreach (var seg in category.Segments.OrderBy(s => s.Order))
            {
                var ri = rowIdx++;
                var thisRun     = ri < splits.Count    ? splits[ri].Duration    : (TimeSpan?)null;
                var compTime    = StatsService.ComparisonTime(category, seg.Id, comparison);
                var delta       = StatsService.Delta(thisRun, compTime);
                var isActive    = running && ri == current;
                var isGold      = thisRun.HasValue && StatsService.IsGold(category, seg.Id, thisRun.Value)
                                  && category.Runs.Any(r => r.Splits.Any(s => s.SegmentId == seg.Id));
                var rating      = StatsService.ConsistencyRating(category, seg.Id);
                var timeSave    = StatsService.PossibleTimeSave(category, seg.Id);

                <tr class="@(isActive ? "text-deeps-400" : "") @(isGold ? "bg-yellow-900/20" : "")
                           border-t border-slate-800">
                    <td class="py-1.5 pr-3 font-sans @(seg.ParentId.HasValue ? "pl-4 text-slate-300" : "")">
                        @(seg.ParentId.HasValue ? "↳ " : "")@seg.IconEmoji @seg.Name
                        @if (isGold) { <span class="ml-1 text-yellow-400 text-xs" title="Gold split!">★</span> }
                        @if (seg.GoalTime.HasValue)
                        {
                            <span class="ml-1 text-xs text-slate-500">🎯@StatsService.Format(seg.GoalTime)</span>
                        }
                    </td>
                    <td>@StatsService.Format(thisRun, Store.Settings.TimerDecimalPlaces)</td>
                    <td class="@DeltaColor(delta)">@StatsService.FormatDelta(delta, Store.Settings.TimerDecimalPlaces)</td>
                    <td>@StatsService.Format(compTime)</td>
                    <td>@StatsService.Format(StatsService.BestSegment(category, seg.Id))</td>
                    <td>@StatsService.FormatSeconds(StatsService.AverageSeconds(category, seg.Id))</td>
                    <td>@StatsService.FormatSeconds(StatsService.Consistency(category, seg.Id))</td>
                    <td>@(rating.HasValue ? $"{rating:F0}" : "--")</td>
                    <td>@StatsService.Format(timeSave)</td>
                    <td>@StatsService.MistakeCount(category, seg.Id)</td>
                </tr>

                @* Active strategy note *@
                var strat = category.Strategies
                    .FirstOrDefault(s => s.SegmentId == seg.Id && s.IsActive);
                if (isActive && strat is not null)
                {
                    <tr class="bg-slate-800/60">
                        <td colspan="10" class="px-2 py-1 text-xs text-slate-300 font-sans italic">
                            💡 <b>@strat.Title</b>: @strat.Notes
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>

    <div class="mt-3 flex flex-wrap gap-4 text-sm text-slate-400">
        <span>PB: <span class="font-mono text-white">@StatsService.Format(StatsService.PersonalBest(category)?.Total)</span></span>
        <span>Sum of best: <span class="font-mono">@StatsService.Format(StatsService.SumOfBest(category))</span></span>
        <span>Attempts: <span class="font-mono">@category.AttemptCount</span></span>
        @if (category.GoalTime.HasValue)
        {
            <span>Goal: <span class="font-mono text-deeps-400">@StatsService.Format(category.GoalTime)</span></span>
        }
    </div>
</div>

@* Reset confirmation *@
@if (showResetPrompt)
{
    <div class="fixed inset-0 z-50 flex items-center justify-center bg-black/60">
        <div class="card w-full max-w-sm space-y-4">
            <h3 class="font-semibold">Reset run?</h3>
            <p class="text-sm text-slate-400">Save this attempt to history or discard it?</p>
            <div class="flex flex-col gap-2" @onkeydown:stopPropagation="true">
                <button class="btn-primary" @onclick="ResetSave">Save run &amp; reset</button>
                <button class="btn-ghost text-red-400" @onclick="ResetDiscard">Discard &amp; reset</button>
                <button class="btn-ghost"              @onclick="@(() => showResetPrompt = false)">Keep running</button>
            </div>
        </div>
    </div>
}

</div>@* end focus wrapper *@

@code {
    [Parameter] public Guid CategoryId { get; set; }

    private Category? category;
    private bool      running;
    private bool      paused;
    private int       current;
    private TimeSpan  elapsed;
    private TimeSpan  lastSplitAt;
    private TimeSpan  pausedAt;
    private List<SplitTime> splits    = new();
    private List<Mistake>   mistakes  = new();
    private string    mistakeNote     = "";
    private string    mistakeCategory = "";
    private double    mistakeSeconds;
    private string    runNotes        = "";
    private string    comparison      = "PersonalBest";
    private TimeSpan? bestPossible;
    private TimeSpan? pbTime;
    private bool      showResetPrompt;

    // countdown
    private int       countdown;
    private Timer?    countdownTimer;

    // segment loop
    private bool      segLoopEnabled;
    private int       loopSegIndex;
    private int       loopAttempts;

    private readonly System.Diagnostics.Stopwatch sw = new();
    private Timer?    ticker;
    private Timer?    gamepadTimer;
    private HashSet<int> prevGamepadButtons = new();
    private ElementReference pageRef;

    private static readonly string[] mistakeCategories =
        { "Missed trick", "RNG", "Menu mistake", "Execution", "Knowledge", "Other" };

    protected override void OnInitialized()
    {
        gamepadTimer = new Timer(_ => InvokeAsync(CheckGamepadAsync), null, 200, 50);
    }

    protected override void OnParametersSet()
    {
        category   = Store.FindCategory(CategoryId);
        comparison = Store.Settings.Comparison;
        pbTime     = StatsService.PersonalBest(category!)?.Total;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender) await pageRef.FocusAsync();
    }

    // ─── Keyboard ─────────────────────────────────────────────────────────────

    private async Task OnKeyDown(KeyboardEventArgs e)
    {
        if (!running && !paused && Hotkeys.IsStartOrSplit(e.Key))
        {
            await InvokeAsync(StartOrSplit);
        }
        else if (running && Hotkeys.IsStartOrSplit(e.Key))
        {
            await InvokeAsync(StartOrSplit);
        }
        else if (running && Hotkeys.IsPause(e.Key))
        {
            Pause();
        }
        else if (paused && Hotkeys.IsPause(e.Key))
        {
            Resume();
        }
        else if (running && Hotkeys.IsUndo(e.Key))
        {
            UndoSplit();
        }
        else if (running && Hotkeys.IsSkip(e.Key))
        {
            SkipSplit();
        }
        else if ((running || paused) && Hotkeys.IsReset(e.Key))
        {
            InitiateReset();
        }
        StateHasChanged();
    }

    // ─── Timer controls ───────────────────────────────────────────────────────

    private async Task StartOrSplit()
    {
        if (!running && !paused)
        {
            await BeginRun();
        }
        else if (running)
        {
            Split();
        }
    }

    private async Task BeginRun()
    {
        if (category is null) return;
        splits    = new();
        mistakes  = new();
        runNotes  = "";
        current   = segLoopEnabled ? loopSegIndex : 0;
        lastSplitAt = TimeSpan.Zero;
        elapsed   = TimeSpan.Zero;
        paused    = false;
        category.AttemptCount++;

        int delay = Store.Settings.StartDelay;
        if (delay > 0)
        {
            countdown = delay;
            StateHasChanged();
            countdownTimer = new Timer(_ =>
            {
                InvokeAsync(() =>
                {
                    countdown--;
                    if (countdown <= 0) { countdownTimer?.Dispose(); countdownTimer = null; ActivateTimer(); }
                    StateHasChanged();
                });
            }, null, 1000, 1000);
        }
        else
        {
            ActivateTimer();
        }
        await Store.SaveAsync(); // persist attempt count
    }

    private void ActivateTimer()
    {
        running = true;
        sw.Restart();
        ticker  = new Timer(_ => InvokeAsync(() =>
        {
            elapsed = sw.Elapsed + pausedAt;
            bestPossible = StatsService.BestPossibleTime(category!, splits, current);
            StateHasChanged();
        }), null, 0, 50);
    }

    private void Split()
    {
        if (category is null || !running) return;
        var now = sw.Elapsed + pausedAt;
        splits.Add(new SplitTime
        {
            SegmentId = category.Segments.OrderBy(s => s.Order).ElementAt(current).Id,
            Duration  = now - lastSplitAt
        });
        lastSplitAt = now;
        current++;

        if (segLoopEnabled || current >= category.Segments.Count)
        {
            if (segLoopEnabled) { loopAttempts++; lastSplitAt = now; current = loopSegIndex; }
            else Finish();
        }
    }

    private void UndoSplit()
    {
        if (splits.Count == 0) return;
        splits.RemoveAt(splits.Count - 1);
        current = Math.Max(0, current - 1);
        // Recalc lastSplitAt
        lastSplitAt = splits.Count > 0
            ? TimeSpan.FromTicks(splits.Sum(s => s.Duration.Ticks))
            : TimeSpan.Zero;
    }

    private void SkipSplit()
    {
        if (category is null || !running) return;
        var now = sw.Elapsed + pausedAt;
        // Add zero-duration split (skipped)
        splits.Add(new SplitTime
        {
            SegmentId = category.Segments.OrderBy(s => s.Order).ElementAt(current).Id,
            Duration  = TimeSpan.Zero
        });
        current++;
        if (current >= category.Segments.Count) Finish();
    }

    private void Pause()
    {
        if (!running) return;
        sw.Stop();
        ticker?.Dispose(); ticker = null;
        pausedAt = elapsed;
        running = false;
        paused  = true;
    }

    private void Resume()
    {
        if (!paused) return;
        paused = false;
        running = true;
        sw.Restart();
        ticker = new Timer(_ => InvokeAsync(() =>
        {
            elapsed = sw.Elapsed + pausedAt;
            StateHasChanged();
        }), null, 0, 50);
    }

    private void InitiateReset()
    {
        if (!running && !paused) return;
        Pause();
        showResetPrompt = true;
    }

    private async Task ResetSave()
    {
        if (category is null) return;
        showResetPrompt = false;
        StopTimer();
        var run = new Run
        {
            Completed            = false,
            ResetAtSegmentIndex  = current,
            Splits               = splits,
            Mistakes             = mistakes,
            Notes                = runNotes
        };
        await Store.SaveRunAsync(category, run);
        ResetState();
    }

    private void ResetDiscard()
    {
        showResetPrompt = false;
        StopTimer();
        ResetState();
    }

    private void Finish()
    {
        if (category is null) return;
        StopTimer();
        var run = new Run
        {
            Completed = true,
            Splits    = splits,
            Mistakes  = mistakes,
            Notes     = runNotes
        };
        _ = Store.SaveRunAsync(category, run);
        pbTime = StatsService.PersonalBest(category)?.Total;
        ResetState();
    }

    private void StopTimer()
    {
        sw.Stop();
        ticker?.Dispose(); ticker = null;
        countdownTimer?.Dispose(); countdownTimer = null;
    }

    private void ResetState()
    {
        running = false; paused = false; current = 0;
        splits = new(); mistakes = new(); elapsed = TimeSpan.Zero;
        lastSplitAt = TimeSpan.Zero; pausedAt = TimeSpan.Zero;
        bestPossible = null; countdown = 0;
    }

    private void LogMistake()
    {
        if (category is null || string.IsNullOrWhiteSpace(mistakeNote)) return;
        int segIdx = Math.Min(current, category.Segments.Count - 1);
        mistakes.Add(new Mistake
        {
            SegmentId  = category.Segments.OrderBy(s => s.Order).ElementAt(segIdx).Id,
            Note       = mistakeNote.Trim(),
            Category   = mistakeCategory,
            SecondsLost= mistakeSeconds
        });
        mistakeNote = ""; mistakeCategory = ""; mistakeSeconds = 0;
    }

    // ─── Colour helpers ───────────────────────────────────────────────────────

    private string TimerColor()
    {
        if (!running && !paused) return "text-slate-200";
        if (paused) return "text-slate-400";
        if (splits.Count == 0) return "text-white";
        var last = splits[^1];
        var comp = StatsService.ComparisonTime(category!, last.SegmentId, comparison);
        var delta = StatsService.Delta(last.Duration, comp);
        if (delta is null) return "text-white";
        return delta.Value < TimeSpan.Zero ? "text-green-400" : "text-red-400";
    }

    private static string DeltaColor(TimeSpan? delta) =>
        delta is null ? "" : delta.Value < TimeSpan.Zero ? "text-green-400" : "text-red-400";

    private async Task CheckGamepadAsync()
    {
        if (!Store.Settings.GamepadEnabled) return;
        try
        {
            var pressedButtons = await JS.InvokeAsync<int[]>("deepsGamepadButtons", 0);
            if (pressedButtons is null) return;
            var currentSet = new HashSet<int>(pressedButtons);

            foreach (var btn in currentSet)
            {
                if (!prevGamepadButtons.Contains(btn))
                {
                    if (btn == Store.Settings.GamepadButtonStartSplit)
                    {
                        await StartOrSplit();
                    }
                    else if (btn == Store.Settings.GamepadButtonPause)
                    {
                        if (running) Pause();
                        else if (paused) Resume();
                    }
                    else if (btn == Store.Settings.GamepadButtonUndo)
                    {
                        if (running) UndoSplit();
                    }
                    else if (btn == Store.Settings.GamepadButtonSkip)
                    {
                        if (running) SkipSplit();
                    }
                    else if (btn == Store.Settings.GamepadButtonReset)
                    {
                        if (running || paused) InitiateReset();
                    }
                }
            }
            prevGamepadButtons = currentSet;
            StateHasChanged();
        }
        catch { }
    }

    public void Dispose()
    {
        ticker?.Dispose();
        countdownTimer?.Dispose();
        gamepadTimer?.Dispose();
    }
}
